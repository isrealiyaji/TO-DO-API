# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# --- Database (required) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=todo_api

# --- Auth (required) ---
# Signs and verifies JWTs. Use a long random value, not a word.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this invalidates every token already issued.
JWT_SECRET=

# --- Server (optional) ---
PORT=3500

# Allowed browser origin. "*" is fine locally; in production set this to your
# frontend's exact origin, e.g. https://app.example.com
CORS_ORIGIN=*
